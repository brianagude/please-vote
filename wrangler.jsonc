{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "please-vote",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "vote.brianagude.com", "custom_domain": true }],
  "observability": { "enabled": true },
  // Lets Cloudflare build a preview of non-main branches (wrangler preview). The live site still deploys only from main.
  "previews": {},
  // A workers.dev address, needed for the per-branch and per-PR preview links. The custom domain above stays the live site.
  "workers_dev": true,
  "preview_urls": true
}
