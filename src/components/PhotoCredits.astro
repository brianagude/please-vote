---
// Where each photo on the page came from, in its own dropdown in the footer, kept apart
// from the fact sources (owner, Oct 15, 2026). This also gives the visible credit that
// Creative Commons "BY" licenses require. People with the same credit share one line;
// each name links to its own photo's source.
import type { Candidate } from "../lib/types";
interface Props {
  people: Candidate[];
}
const withPhoto = Astro.props.people.filter((c) => c.photo).sort((a, b) => a.name.localeCompare(b.name));
const lines = new Map<string, { credit: string; license?: string; people: Candidate[] }>();
for (const c of withPhoto) {
  const credit = c.photo!.credit ?? c.photo!.source.label;
  const key = `${credit}|${c.photo!.license ?? ""}`;
  const line = lines.get(key) ?? { credit, license: c.photo!.license, people: [] };
  line.people.push(c);
  lines.set(key, line);
}
// Biggest groups first (e.g. official portraits), then by credit.
const sorted = [...lines.values()].sort((a, b) => b.people.length - a.people.length || a.credit.localeCompare(b.credit));
---
{
  sorted.length > 0 && (
    <details>
      <summary>Photo credits</summary>
      <ul>
        {sorted.map((l) => (
          <li>
            {l.people.map((c, i) => (
              <>
                {i > 0 && ", "}
                <a href={c.photo!.source.url} target="_blank" rel="noopener">{c.name}</a>
              </>
            ))}
            : {l.credit}
            {l.license && `, ${l.license}`}
          </li>
        ))}
      </ul>
    </details>
  )
}
