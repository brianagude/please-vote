---
import type { StateData } from "../lib/types";
import { byLastName, partyName } from "../lib/names";
import CandidateRow from "./CandidateRow.astro";
import Masthead from "./Masthead.astro";
import DateCards from "./DateCards.astro";
import AddressForm from "./AddressForm.astro";
import BallotGroup from "./BallotGroup.astro";
import RaceCard from "./RaceCard.astro";
interface Props {
  data: StateData;
}
const { data } = Astro.props;
const { config, offices: O, races: R, legislature: L } = data;
const D = config.districts;
const asOf = new Date(config.asOf + "T12:00:00").toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });

// Short labels for the closed-group summary line.
const short = (k: string) => {
  if (k === "@house") return { text: D.house.label, key: "house" };
  if (k === "@upper") return { text: D.upper.label };
  if (k === "@lower") return { text: D.lower.label };
  return { text: O[k.replace("?", "")].title.replace("Public Service Commission", "PSC").replace(/^Amendment (\d+):.*/, "Amendment $1") };
};
const chamber = (k: "upper" | "lower") => ({ k, ...D[k], seats: L[k], running: L.running[k] });
---
<div class="wrap">
  <div class="strip strip-top" aria-hidden="true"></div>
  <Masthead config={config} />
  <DateCards config={config} />
  <AddressForm config={config} />

  <section aria-labelledby="s3">
    <div class="shead"><span class="no">03</span><h2 class="disp" id="s3" tabindex="-1">Who's on your ballot</h2></div>
    <p class="note">See the races, who's running, and what they do.</p>
    <div class="groups" id="ballot">
      {
        config.groups.map((g) => (
          <BallotGroup id={g.id} title={g.title} sub={g.sub} inside={g.races.map(short)}>
            {g.races.map((k) => {
              if (k === "@house")
                return (
                  <>
                    <RaceCard office={O.house} data-house="">
                      <div class="row">
                        <div class="cell">
                          <span class="lbl">Candidates</span>
                          <p class="rnote">Enter your address in step 02 to see who's running in your district.</p>
                        </div>
                      </div>
                    </RaceCard>
                    {Object.entries(R.house).map(([n, r]) => (
                      <RaceCard office={O.house} candidates={r.candidates} note={r.note} title={`${D.house.label} · District ${n}`} hidden data-house={n} />
                    ))}
                  </>
                );
              if (k === "@upper" || k === "@lower") {
                const ch = chamber(k.slice(1) as "upper" | "lower");
                return (
                  <RaceCard office={O[ch.office]} data-chamber={ch.k} data-label={ch.label}>
                    <div class="row">
                      <div class="cell" data-seat="">
                        <span class="lbl">Has the seat now</span>
                        <p class="rnote">Pick your {ch.label} district in step 02.</p>
                      </div>
                      {Array.from({ length: ch.count }, (_, i) => String(i + 1)).map((n) => {
                        const p = ch.seats[n];
                        const running = byLastName(ch.running[n] ?? []);
                        return (
                          <div class="cell seat-race" data-seat={n} hidden>
                            {running.length > 0 && (
                              <>
                                <span class="lbl">Candidates</span>
                                <ul class="cands">
                                  {running.map((c) => (
                                    <CandidateRow c={{ id: `${ch.k}-${n}-${c.name}`, name: c.name, party: c.party, incumbent: c.incumbent, links: {} }} />
                                  ))}
                                </ul>
                                {running.length === 1 && <p class="rnote">Only one person is running for this seat.</p>}
                                <a class="src" href={L.running.source.url} target="_blank" rel="noopener">Candidate list: {L.running.source.label}</a>
                              </>
                            )}
                            {p && !running.some((c) => c.incumbent) && (
                              <p class="holder">
                                <span class="lbl">Has the seat now</span>
                                {p.vacant ? "No one" : `${p.name}, ${partyName(p.party)}.`} <a class="src" href={p.source.url} target="_blank" rel="noopener">Source: {p.source.label}</a>
                              </p>
                            )}
                          </div>
                        );
                      })}
                      <div class="cell" data-seat="unknown" hidden>
                        <span class="lbl">Has the seat now</span>
                        <p class="rnote">We couldn't confirm who has this seat. Check your voter page.</p>
                      </div>
                    </div>
                  </RaceCard>
                );
              }
              if (k.startsWith("?")) return <RaceCard office={O[k.slice(1)]} question />;
              return <RaceCard office={O[k]} candidates={R.statewide[k].candidates} />;
            })}
          </BallotGroup>
        ))
      }
    </div>
  </section>

  <footer>
    <p>Info as of {asOf}. {config.footerNote}</p>
    <details>
      <summary>Sources</summary>
      <ul>{data.sources.map((s) => <li>{s.what}: <a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}</ul>
    </details>
    <button class="motion" type="button" id="motion" aria-pressed="false">Stop motion</button>
  </footer>
  <div class="strip strip-bottom" aria-hidden="true"></div>
</div>

<script type="application/json" id="zip-data" set:html={JSON.stringify(data.zipToHouse)} />
<script>
  import { start } from "../scripts/ballot";
  start();
</script>
