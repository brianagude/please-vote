---
// A candidate's career record: facts only, each line with its source.
import type { CareerRecord } from "../lib/types";
interface Props {
  r: CareerRecord;
}
const { r } = Astro.props;

const money = (n: number) =>
  n >= 1e6 ? `$${(n / 1e6).toFixed(n >= 1e7 ? 0 : 1)} million` : `$${(Math.round(n / 100) * 100).toLocaleString("en-US")}`;
const pct = (part: number, whole: number) => (whole > 0 ? Math.round((part / whole) * 100) : 0);
const year = (d?: string) => d?.slice(0, 4);
const monthYear = (d?: string) => (d ? new Date(d + "T12:00:00").toLocaleDateString("en-US", { month: "short", year: "numeric" }) : "");
const longDate = (d?: string) => (d ? new Date(d + "T12:00:00").toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" }) : "");
const m = r.money && !("none" in r.money) ? r.money : undefined;
---
<dl class="rec">
  {
    r.offices && r.offices.items.length > 0 && (
      <div>
        <dt class="lbl">Offices held</dt>
        <dd>
          <ul>{r.offices.items.map((o) => <li>{o.title} · {year(o.from)}–{o.to ? year(o.to) : "now"}</li>)}</ul>
          <a class="src" href={r.offices.source.url} target="_blank" rel="noopener">Source: {r.offices.source.label}</a>
        </dd>
      </div>
    )
  }
  {
    r.roles && (
      <div>
        <dt class="lbl">Leadership roles</dt>
        <dd>
          <ul>{r.roles.items.map((x) => <li>{x}</li>)}</ul>
          <a class="src" href={r.roles.source.url} target="_blank" rel="noopener">Source: {r.roles.source.label}</a>
        </dd>
      </div>
    )
  }
  {
    r.bills && (
      <div>
        <dt class="lbl">Bills they wrote</dt>
        <dd>
          <p>
            {r.bills.wrote === 0
              ? `Wrote no bills since ${year(r.bills.since)}.`
              : `Wrote ${r.bills.wrote} ${r.bills.wrote === 1 ? "bill" : "bills"} since ${year(r.bills.since)}. ${r.bills.becameLaw === 0 ? "None" : r.bills.becameLaw} became law.`}
          </p>
          {r.bills.laws.length > 0 && (
            <details class="laws">
              <summary>See the {r.bills.laws.length === 1 ? "one" : r.bills.laws.length} that became law</summary>
              <ul>
                {r.bills.laws.map((l) => (
                  <li>
                    <a href={l.url} target="_blank" rel="noopener">{l.id}</a>: {l.title}
                  </li>
                ))}
              </ul>
            </details>
          )}
          <a class="src" href={r.bills.source.url} target="_blank" rel="noopener">Source: {r.bills.source.label}</a>
        </dd>
      </div>
    )
  }
  {
    r.money && (
      <div>
        <dt class="lbl">Campaign money</dt>
        <dd>
          {m ? (
            <>
              <p>
                Raised {money(m.raised)} and spent {money(m.spent)} since {monthYear(m.from)}. Had {money(m.cashOnHand)} left as of {longDate(m.through)}.
              </p>
              <p>
                {pct(m.fromIndividuals, m.raised)}% came from individual donors and {pct(m.fromPACs, m.raised)}% from PACs (groups that collect money to give to
                candidates).
              </p>
            </>
          ) : (
            <p>No totals yet. The FEC only lists a candidate after they raise or spend more than $5,000.</p>
          )}
          <a class="src" href={r.money.source.url} target="_blank" rel="noopener">Source: {r.money.source.label}</a>
        </dd>
      </div>
    )
  }
</dl>
