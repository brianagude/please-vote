---
import Base from "../layouts/Base.astro";
import StateGuide from "../components/StateGuide.astro";
import { loadState } from "../lib/state";

// Georgia is the only state for now. A second state means a second data
// folder and a page like this one.
const data = loadState("ga");
---
<Base title="Election Day Need-to-Know" description="When to vote in Georgia, what's on your ballot, and who's running. Nonpartisan.">
  <StateGuide data={data} />
</Base>
