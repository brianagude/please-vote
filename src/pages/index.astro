---
import Base from "../layouts/Base.astro";
import StateGuide from "../components/StateGuide.astro";
import { loadState, stateList } from "../lib/state";

// Georgia stays at the main address so links already shared keep working.
// Other states are at /<code>/ (src/pages/[state]/index.astro).
const data = loadState("ga");
---
<Base title="Please Vote" description="A nonpartisan guide to Georgia's 2026 midterms: when to vote, what's on your ballot, and who's running.">
  <StateGuide data={data} states={stateList()} />
</Base>
